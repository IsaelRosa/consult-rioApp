# ---- Banco de dados (MySQL) ----
# Obrigatórios em produção: sem isso a API sobe em modo demo (dados em memória).
DB_HOST=localhost
DB_PORT=3306
DB_NAME=odontoclinic
DB_USER=root
DB_PASSWORD=

# ---- Aplicação ----
PORT=3001
HOST=0.0.0.0

# Segredo usado para assinar o token de sessão (HMAC).
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Sem este valor, as sessões expiram a cada reinício do processo.
SESSION_SECRET=

# ---- Front-end ----
# Deixe VITE_API_URL vazio/ausente em produção: o front usa /api no mesmo domínio.
# Só defina se a API estiver em outro host.
# VITE_API_URL=http://localhost:3001/api